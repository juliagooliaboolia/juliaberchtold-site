---
import { EMAIL } from '../data/site.js';
interface Props { kind?: 'shoot' | 'jewelry'; heading?: string; id?: string }
const { kind = 'shoot', heading, id } = Astro.props;
const shootQs = ['Your name:', 'What kind of shoot (wedding, newborn, portrait, event…)?', 'Who will be there?', 'What should these photos feel like?', 'Anyone camera-shy? Most people are.', 'Roughly when, and where?'];
const jewelQs = ['Your name:', 'A piece you saw in the studio, or a commission?', 'Who is it for, and what is the occasion?', 'Colors, shapes or stories you love:', 'When do you need it by?'];
const qs = kind === 'shoot' ? shootQs : jewelQs;
const subject = kind === 'shoot' ? 'Photo shoot inquiry' : 'Jewelry inquiry';
const href = `mailto:${EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent('Hi Julia,\n\n' + qs.map((q) => q + '\n\n').join(''))}`;
---
<section class="inq" id={id}>
  <div class="l">
    <span class="caps muted">{kind === 'shoot' ? 'Ask about a shoot' : 'Pieces & commissions'}</span>
    <h2 class="display">{heading ?? (kind === 'shoot' ? "Tell me who'll be there, and what you want to remember." : 'Tell me who it’s for, and I’ll tell you what I see.')}</h2>
  </div>
  <div class="r">
    <p class="muted" style="margin:0 0 6px">A few things I'll ask:</p>
    <ol>{qs.slice(1).map((q) => <li>{q}</li>)}</ol>
    <a class="pill solid caps" href={href}>Email me</a>
    <p class="muted" style="font-size:13px;margin:4px 0 0">Or write to <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.</p>
  </div>
</section>
<style>
  .inq{display:grid;grid-template-columns:5fr 1fr 6fr;gap:24px;padding-top:64px;border-top:1px solid var(--line)}
  .l{display:flex;flex-direction:column;gap:20px}
  .l .display{font-size:clamp(32px,4vw,44px);line-height:1.08}
  .r{grid-column:3;display:flex;flex-direction:column;gap:12px;align-items:flex-start}
  ol{margin:0 0 12px;padding-left:20px;display:flex;flex-direction:column;gap:8px;font-size:17px;line-height:1.5;color:var(--body)}
  @media (max-width:820px){ .inq{grid-template-columns:1fr;gap:28px} .r{grid-column:1} }
</style>
