---
import Base from '../../layouts/Base.astro';
import Inquiry from '../../components/Inquiry.astro';
import { INSTAGRAM, INSTAGRAM_STUDIO } from '../../data/site.js';
import { COPY } from '../../data/copy.js';
const Q = COPY.inquire;
---
<Base title="Inquire" active="Inquire" description={Q.description}>
  <main class="wrap">
    <section class="top">
      <h1 class="display" style="font-size:clamp(52px,7vw,84px)">{Q.heading}</h1>
      <p class="lead" style="max-width:640px">{Q.intro}</p>
      <p class="muted" style="margin:0">{Q.instagram_line} <a href={INSTAGRAM.url}>{INSTAGRAM.handle}</a> · <a href={INSTAGRAM_STUDIO.url}>{INSTAGRAM_STUDIO.handle}</a></p>
    </section>
    <Inquiry kind="shoot" id="shoot" />
    <div style="height:72px"></div>
    <Inquiry kind="jewelry" id="jewelry" />
    <div style="height:72px"></div>
  </main>
</Base>
<style> .top{display:flex;flex-direction:column;gap:18px;padding:24px 0 72px} </style>
