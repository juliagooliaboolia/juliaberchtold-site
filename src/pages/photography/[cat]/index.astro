---
import Base from '../../../layouts/Base.astro';
import Inquiry from '../../../components/Inquiry.astro';
import { u } from '../../../data/site.js';
import { CATEGORIES, SETS } from '../../../data/photos.js';
export function getStaticPaths() { return Object.keys(CATEGORIES).map((cat) => ({ params: { cat } })); }
const { cat } = Astro.params;
const c = CATEGORIES[cat];
const set = SETS[cat];
---
<Base title={c.title} active="Photography" description={c.blurb}>
  <main class="wrap">
    <section class="intro">
      <nav class="cats" aria-label="Galleries">
        {Object.entries(CATEGORIES).map(([k, v]) => <a class:list={['pill', { on: k === cat }]} href={u('photography/' + k + '/')} aria-current={k === cat ? 'page' : undefined}>{v.title}</a>)}
      </nav>
      <div class="head">
        <h1 class="display">{c.title}</h1>
        <p class="lead">{c.blurb}</p>
      </div>
    </section>

    <article class="story">
      <div class="meta">
        <span class="caps muted">{c.story.meta} · {set.length} photos</span>
        <h2 class="display" style="font-size:44px">{c.story.title}</h2>
        <p class="hand note">{c.word}</p>
        <a class="lnk" href={u('photography/' + cat + '/story/')}>View the story →</a>
      </div>
      <button type="button" class="stack" aria-label="Show the next photo in this story">
        {set.map(([f, o, alt], i) => <img class="fr-img" data-o={o} src={u('img/' + f)} alt={alt} loading="lazy" />)}
      </button>
    </article>

    <Inquiry kind="shoot" id="ask" />
    <div style="height:48px"></div>
  </main>
</Base>
<style>
  .intro{display:flex;flex-direction:column;gap:28px;padding:32px 0 56px}
  .cats{display:flex;flex-wrap:wrap;gap:10px}
  .cats .pill{font-size:14px;border-color:#1F1A1B33}
  .cats .pill.on{background:var(--ink);color:var(--paper);border-color:var(--ink)}
  .head{display:grid;grid-template-columns:7fr 1fr 4fr;align-items:end;gap:24px}
  .head .display{font-size:clamp(52px,7vw,84px);line-height:.98}
  .head .lead{grid-column:3;font-size:16px;color:var(--muted)}
  .story{display:flex;align-items:center;justify-content:space-between;gap:56px;padding:56px 0;border-top:1px solid var(--line)}
  .meta{display:flex;flex-direction:column;gap:16px;max-width:400px}
  .note{font-size:34px;margin:6px 0 0;transform:rotate(-1.5deg)}
  .stack{position:relative;width:min(560px,100%);aspect-ratio:560/440;border:none;background:transparent;cursor:pointer;padding:0;flex-shrink:0}
  .fr-img{position:absolute;left:50%;top:50%;object-fit:cover;background:#E6E1D9;border:9px solid #fff;box-shadow:0 12px 26px rgba(31,26,27,.15);transition:transform .5s cubic-bezier(.2,.8,.2,1)}
  .fr-img[data-o="p"]{width:47%;height:90%} .fr-img[data-o="l"]{width:75%;height:64%}
  @media (max-width:820px){ .head{grid-template-columns:1fr} .head .lead{grid-column:1} .story{flex-direction:column;align-items:stretch;gap:32px} }
</style>
<script>
  document.querySelectorAll('.stack').forEach((st) => {
    const imgs = [...st.querySelectorAll('img')]; const n = imgs.length; let top = 0;
    const pos = [[0, 0, 1, 5], [23, 6, .88, 4], [-23, -6, .88, 3], [0, 3, .8, 2], [0, -3, .8, 1]];
    const lay = () => imgs.forEach((im, i) => { const [x, r, s, z] = pos[Math.min((i - top + n) % n, pos.length - 1)]; im.style.zIndex = z; im.style.transform = `translate(-50%,-50%) translateX(${x}%) rotate(${r}deg) scale(${s})`; });
    lay(); st.addEventListener('click', () => { top = (top + 1) % n; lay(); });
  });
</script>
