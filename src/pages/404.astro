---
import Base from '../layouts/Base.astro';
import { u } from '../data/site.js';
import { COPY } from '../data/copy.js';
---
<Base title="Not found">
  <script is:inline slot="head">
    // Old Il Bel Viaggio links (juliaberchtold.com/ilbelviaggio/...) now live on the archive subdomain.
    if (/^\/(ilbelviaggio|cover-page)(\/|$)/.test(location.pathname)) location.replace('https://archive.juliaberchtold.com' + location.pathname + location.search + location.hash);
  </script>
  <main class="wrap" style="padding:80px var(--gutter) 120px;display:flex;flex-direction:column;gap:20px;align-items:flex-start">
    <span class="fr vn" style="font-size:clamp(72px,10vw,140px)">notice</span>
    <p class="hand" style="font-size:40px">{COPY.not_found.text}</p>
    <a class="pill solid caps" href={u('')}>{COPY.not_found.button}</a>
  </main>
</Base>
