---
import Base from '../layouts/Base.astro';
import ItalyMap from '../components/ItalyMap.astro';
import { u } from '../data/site.js';
import { NOTICE, WATERCOLORS, MAKE_UNDER } from '../data/photos.js';
---
<Base description="Julia Berchtold — I notice, I explore, I make. Photographs for friends and friends of friends, a Rome guide, and one-of-a-kind jewelry.">
  <main>
    <section class="hero wrap" aria-label="Notice, explore, make">
      <!-- notice -->
      <a class="panel notice" href={u('photography/')} aria-label="Photography: notice">
        <div class="pile">
          {NOTICE.map(([f, alt], i) => (
            <div class="pr" data-i={i} data-word={NOTICE[i][2]} style={i === 0 ? 'opacity:1;transform:none;z-index:3' : ''}>
              <img src={u('img/' + f)} alt={i === 0 ? alt : ''} data-alt={alt} loading={i < 2 ? 'eager' : 'lazy'} />
            </div>
          ))}
          <div class="vignette" aria-hidden="true"></div>
        </div>
        <div class="center">
          <span class="fr vn verb">notice</span>
          <span class="hand word" aria-hidden="true">{NOTICE[0][2]}</span>
        </div>
      </a>

      <!-- explore -->
      <div class="panel explore">
        <div class="map"><ItalyMap /></div>
        <a href={u('travel/')} class="fr ve verb" tabindex="-1">explore</a>
        <svg class="string" aria-hidden="true"><path d="" /></svg>
        <a class="rome" href={u('travel/rome/')} aria-label="My Rome guide">
          <span class="tack" aria-hidden="true"></span>
          <img src={u('img/p/trv-italy-rome-4.jpg')} alt="Ponte Sisto at golden hour, Rome" loading="lazy" />
          <span class="cap"><span class="hand">Rome</span><span class="caps">my guide →</span></span>
        </a>
      </div>

      <!-- make -->
      <div class="make-col">
        <a class="panel make" href={u('studio/')} aria-label="Studio: make" data-watercolors={JSON.stringify(WATERCOLORS.map((w) => u('img/' + w)))}>
          <div class="edge">
            <img class="under" src={u('img/' + MAKE_UNDER)} alt="Sacred feminine earrings, revealed under one of Julia's watercolors" />
            <canvas aria-hidden="true"></canvas>
          </div>
          <span class="fr vm verb">make</span>
        </a>
        <button class="repaint caps" type="button" aria-label="Paint a different watercolor over the earrings">↺ repaint</button>
      </div>
    </section>

    <section class="descs wrap" aria-label="What you'll find here">
      <div class="desc">
        <span class="fr vn" style="font-size:30px">notice</span>
        <span class="caps muted">Photography</span>
        <h2 class="fr dh">The moments I capture</h2>
        <p class="dp">Weddings, new babies, people and community gatherings, for friends and friends of friends. I'm usually the one getting the room to laugh, which is when the real moments happen.</p>
        <div class="dl"><a class="lnk" href={u('photography/')}>See my photographs →</a><a class="lnk" href={u('inquire/#shoot')}>Ask about a shoot</a></div>
      </div>
      <div class="desc">
        <span class="fr ve" style="font-size:30px">explore</span>
        <span class="caps muted">Travel</span>
        <h2 class="fr dh">The places I wander</h2>
        <p class="dp">Eighteen of Italy's twenty regions and counting, the Rome guide I keep for friends, and the places farther afield that changed how I see the world.</p>
        <div class="dl"><a class="lnk" href={u('travel/')}>Open the map →</a><a class="lnk" href={u('travel/rome/')}>The Rome guide</a></div>
      </div>
      <div class="desc">
        <span class="fr vm" style="font-size:30px">make</span>
        <span class="caps muted">Studio</span>
        <h2 class="fr dh">The things I make</h2>
        <p class="dp">Jewelry that makes a statement, for a good cause. A portion of every sale goes to a new charitable organization each month. Some pieces are ready now; others I'll make with you.</p>
        <div class="dl"><a class="lnk" href={u('studio/')}>Visit juju.bee studio →</a></div>
      </div>
    </section>

    <section class="about-blade" aria-labelledby="h-about">
      <div class="inner wrap">
        <img class="me" src={u('img/julia-vittoriano-crop.jpg')} alt="Julia smiling, with her camera, in front of the Vittoriano in Rome" loading="lazy" />
        <div class="txt">
          <span class="caps muted">About</span>
          <h2 id="h-about" class="display" style="font-size:40px">Hi, I'm Julia.</h2>
          <p>I'm Julia (or "Juju"), an amateur photographer, designer, maker, and collector of moments, stories, and way too many hobbies. I'm endlessly fascinated by people, the places that shape us, and the beauty hiding in plain sight. This little space is where all my curiosities come together.</p>
        </div>
        <div class="sign">
          <span class="hand" aria-label="Signed, Julia" style="font-size:58px;transform:rotate(-4deg)">Julia</span>
          <a class="pill solid caps" href={u('about/')}>More about me →</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .hero{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:36px;padding-top:12px;padding-bottom:8px}
  .panel{position:relative;display:block;height:clamp(460px,calc(100svh - 150px),624px);text-decoration:none;color:var(--ink)}
  /* all three verbs share one centerline: the vertical middle of their panels */
  .verb{position:absolute;left:0;right:0;top:50%;transform:translateY(-50%);text-align:center;font-size:clamp(72px,8vw,104px);line-height:1;pointer-events:none;text-decoration:none}

  /* notice */
  .pile{position:absolute;inset:10px;overflow:hidden;background:#E6E1D9}
  .pr{position:absolute;inset:0;opacity:0;transform:rotate(-7deg) translate(-30px,-18px) scale(1.06);z-index:1;transition:transform .8s cubic-bezier(.2,.7,.2,1),opacity .5s ease}
  .pr img{width:100%;height:100%;object-fit:cover}
  .vignette{position:absolute;inset:0;z-index:4;background:radial-gradient(70% 40% at 50% 52%,rgba(20,16,16,.38),rgba(20,16,16,0))}
  .notice .center{position:absolute;inset:0;z-index:5;text-align:center;color:#FBF8F3;pointer-events:none}
  .notice .verb{color:#FBF8F3}
  .notice .word{position:absolute;left:0;right:0;top:calc(50% + clamp(36px,4vw,52px));font-size:48px;color:#FBF8F3;text-shadow:0 1px 10px rgba(0,0,0,.4)}

  /* explore */
  .explore .map{position:absolute;left:0;right:0;top:40px;bottom:110px;display:flex;justify-content:center}
  .explore .map :global(svg){height:100%;width:auto;max-width:100%}
  .explore .verb{z-index:2;text-shadow:0 0 18px var(--paper),0 0 6px var(--paper),0 0 2px var(--paper)}
  /* the Rome guide: a Polaroid of Ponte Sisto, tied to the Rome pin with a thread */
  .rome{position:absolute;left:0;bottom:0;width:128px;z-index:3;transform:rotate(-3deg);transform-origin:50% 0;display:flex;flex-direction:column;gap:6px;background:var(--card);padding:8px 8px 10px;box-shadow:0 1px 2px rgba(31,26,27,.12),0 10px 22px rgba(31,26,27,.14);text-decoration:none;color:var(--ink);transition:transform .35s cubic-bezier(.2,.7,.2,1),box-shadow .35s ease}
  .rome:hover,.rome:focus-visible{transform:rotate(0) translateY(-4px);box-shadow:0 1px 2px rgba(31,26,27,.12),0 16px 30px rgba(31,26,27,.18);color:var(--ink)}
  .rome img{width:100%;aspect-ratio:4/5;object-fit:cover}
  .rome .cap{display:flex;justify-content:space-between;align-items:baseline;gap:6px;padding:0 2px}
  .rome .cap .hand{font-size:30px;transform:rotate(-3deg)}
  .rome .cap .caps{font-size:9.5px;letter-spacing:.14em;color:var(--muted);white-space:nowrap}
  .rome .tack{position:absolute;left:50%;top:-5px;width:11px;height:11px;margin-left:-5.5px;border-radius:50%;background:var(--ink);box-shadow:0 1px 2px rgba(0,0,0,.3)}
  .string{position:absolute;inset:0;z-index:1;width:100%;height:100%;pointer-events:none;overflow:visible}
  .string path{fill:none;stroke:var(--ink);stroke-opacity:.45;stroke-width:1;stroke-dasharray:3 4}

  /* make */
  .make-col{display:flex;flex-direction:column;align-items:stretch}
  .make{color:#FBF8F3;touch-action:pan-y;cursor:crosshair}
  .make:hover{color:#FBF8F3}
  .make .edge{position:absolute;inset:0;-webkit-mask:url('../img/edge-mask.png') center/100% 100% no-repeat;mask:url('../img/edge-mask.png') center/100% 100% no-repeat}
  .make .under,.make canvas{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .make .verb{text-shadow:0 2px 18px rgba(20,16,16,.4)}
  .repaint{align-self:flex-end;min-height:36px;border:none;background:transparent;color:var(--muted);cursor:pointer;font:inherit;font-size:10px;letter-spacing:.18em;margin-top:4px}

  /* descriptions */
  .descs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:36px;padding-top:56px;padding-bottom:56px;border-top:1px solid var(--line);margin-top:8px}
  .desc{display:flex;flex-direction:column;gap:10px}
  .dh{margin:8px 0 0;font-weight:300;font-size:32px;line-height:1.08;font-variation-settings:'opsz' 72,'wght' 320,'SOFT' 30}
  .dp{margin:4px 0 0;font-size:15px;line-height:1.65;color:var(--body)}
  .dl{display:flex;flex-wrap:wrap;gap:0 24px}

  /* about */
  .about-blade{background:var(--paper-2)}
  .about-blade .inner{display:grid;grid-template-columns:200px minmax(0,1fr) 240px;gap:48px;align-items:center;padding-top:48px;padding-bottom:48px}
  .about-blade .me{width:200px;height:250px;object-fit:cover}
  .about-blade .txt{display:flex;flex-direction:column;gap:14px}
  .about-blade .txt p{margin:0;font-size:16px;line-height:1.6;color:var(--body);max-width:580px}
  .about-blade .sign{display:flex;flex-direction:column;align-items:flex-start;gap:18px}

  @media (max-width:1000px){
    .hero{gap:20px}
    .rome{width:116px}
  }
  @media (max-width:820px){
    .hero{grid-template-columns:1fr;gap:28px}
    .panel{height:min(68svh,560px)}
    .explore{height:auto;aspect-ratio:400/560;max-height:620px}
    .explore .map{top:0;bottom:90px}
    .rome{width:112px}
    .descs{grid-template-columns:1fr;gap:40px}
    .about-blade .inner{grid-template-columns:1fr;gap:20px}
    .about-blade .me{width:100%;height:auto;aspect-ratio:4/5;max-width:360px}
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- notice: a new print lands every few seconds ----
  const notice = document.querySelector('.notice');
  if (notice) {
    const prints = [...notice.querySelectorAll('.pr')];
    const word = notice.querySelector('.word');
    let cur = 0, prev = -1, hover = false, flip = false;
    // long words step down so they stay inside the photo
    const fit = () => { const n = word.textContent.length; word.style.fontSize = n > 16 ? '34px' : n > 11 ? '40px' : '48px'; };
    fit();
    const show = () => prints.forEach((p, i) => {
      const img = p.querySelector('img');
      img.alt = i === cur ? img.dataset.alt : '';
      if (i === cur) { p.style.transition = ''; p.style.opacity = '1'; p.style.transform = 'none'; p.style.zIndex = '3'; }
      else if (i === prev) { p.style.zIndex = '2'; }
      else { p.style.transition = 'none'; p.style.opacity = '0'; p.style.transform = 'rotate(-7deg) translate(-30px,-18px) scale(1.06)'; p.style.zIndex = '1'; }
    });
    const next = () => {
      if (!hover) {
        prev = cur; cur = (cur + 1) % prints.length; show();
        word.textContent = prints[cur].dataset.word; fit();
        flip = !flip; word.style.animation = 'none'; void word.offsetWidth;
        word.style.animation = (flip ? 'writeA' : 'writeB') + ' .9s .35s ease-out both';
      }
    };
    notice.addEventListener('mouseenter', () => hover = true);
    notice.addEventListener('mouseleave', () => hover = false);
    notice.addEventListener('focusin', () => hover = true);
    notice.addEventListener('focusout', () => hover = false);
    if (!reduce) setInterval(next, 3000);
  }

  // ---- explore: a thread from the Rome pin to the Polaroid's tack ----
  const explore = document.querySelector('.explore');
  if (explore) {
    const path = explore.querySelector('.string path');
    const pin = explore.querySelector('svg.italy circle');
    const tack = explore.querySelector('.rome .tack');
    const draw = () => {
      const P = explore.getBoundingClientRect(), a = pin.getBoundingClientRect(), b = tack.getBoundingClientRect();
      const x1 = a.left + a.width / 2 - P.left, y1 = a.top + a.height / 2 - P.top;
      const x2 = b.left + b.width / 2 - P.left, y2 = b.top + b.height / 2 - P.top;
      const mx = (x1 + x2) / 2 + 30, my = (y1 + y2) / 2 + 40;
      path.setAttribute('d', `M${x1.toFixed(1)},${y1.toFixed(1)} Q${mx.toFixed(1)},${my.toFixed(1)} ${x2.toFixed(1)},${y2.toFixed(1)}`);
    };
    draw(); addEventListener('resize', draw); addEventListener('load', draw);
    explore.querySelector('.rome').addEventListener('transitionend', draw);
  }

  // ---- make: the watercolor erases to reveal the earrings; repaint brings the next one ----
  const make = document.querySelector('.make');
  if (make) {
    const canvas = make.querySelector('canvas');
    const ctx = canvas.getContext('2d');
    const list = JSON.parse(make.dataset.watercolors);
    const imgs = list.map((src) => { const im = new Image(); im.src = src; return im; });
    let idx = 0, W = 0, H = 0, dpr = 1, last = null;

    const cover = (im, alpha = 1) => {
      if (!im.complete || !im.naturalWidth) return;
      const s = Math.max(W / im.naturalWidth, H / im.naturalHeight);
      const w = im.naturalWidth * s, h = im.naturalHeight * s;
      ctx.save(); ctx.globalCompositeOperation = 'source-over'; ctx.globalAlpha = alpha;
      ctx.drawImage(im, (W - w) / 2, (H - h) / 2, w, h); ctx.restore();
    };
    const size = () => {
      const r = make.getBoundingClientRect(); dpr = Math.min(2, devicePixelRatio || 1);
      W = r.width; H = r.height; canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0); cover(imgs[idx]);
    };
    imgs[0].onload = size; size();
    let rw = 0; new ResizeObserver(() => { const w = make.getBoundingClientRect().width; if (Math.abs(w - rw) > 2) { rw = w; size(); } }).observe(make);

    // a soft, irregular "wet" blot, grown over ~0.5s
    const blot = (x, y) => {
      const R = (W / 360) * (30 + Math.random() * 20);
      const parts = Array.from({ length: 7 }, () => [x + (Math.random() - .5) * R * .9, y + (Math.random() - .5) * R * .9, R * (.45 + Math.random() * .35)]);
      const t0 = performance.now();
      const step = (now) => {
        const g = reduce ? 1 : Math.min(1, (now - t0) / 500), e = 1 - Math.pow(1 - g, 3);
        ctx.save(); ctx.globalCompositeOperation = 'destination-out';
        for (const [px, py, pr] of parts) {
          const r = pr * e; if (r < 1) continue;
          const grd = ctx.createRadialGradient(px, py, r * .35, px, py, r);
          grd.addColorStop(0, 'rgba(0,0,0,.9)'); grd.addColorStop(1, 'rgba(0,0,0,0)');
          ctx.fillStyle = grd; ctx.beginPath(); ctx.arc(px, py, r, 0, Math.PI * 2); ctx.fill();
        }
        ctx.restore();
        if (g < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    make.addEventListener('pointermove', (e) => {
      const r = make.getBoundingClientRect(); const x = e.clientX - r.left, y = e.clientY - r.top;
      if (last && Math.hypot(x - last[0], y - last[1]) < 18 * (W / 360)) return;
      last = [x, y]; blot(x, y);
    });
    make.addEventListener('pointerleave', () => last = null);

    document.querySelector('.repaint')?.addEventListener('click', () => {
      idx = (idx + 1) % imgs.length; const im = imgs[idx]; const t0 = performance.now();
      const fade = (now) => {
        const g = reduce ? 1 : Math.min(1, (now - t0) / 1100);
        cover(im, g < 1 ? 0.12 : 1);
        if (g < 1) requestAnimationFrame(fade);
      };
      if (im.complete) requestAnimationFrame(fade); else im.onload = () => requestAnimationFrame(fade);
    });
  }
</script>
