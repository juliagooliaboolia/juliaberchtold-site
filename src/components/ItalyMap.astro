---
import regions from '../data/regions.json';
import { u } from '../data/site.js';
// Regions not yet visited ("on my list"). Everything else is shaded.
const NOT_YET = ['Friuli-Venezia Giulia', 'Basilicata'];
interface Props { href?: string; animate?: boolean; class?: string; label?: boolean }
const { href = 'travel/', animate = true, class: cls = '', label = true } = Astro.props;
let k = 0;
---
<svg class:list={['italy', cls]} viewBox="0 0 400 470" role="group" aria-label="Map of Italy: regions I have explored are shaded">
  {regions.map((r, i) => {
    const seen = !NOT_YET.includes(r.name);
    const delay = seen && animate ? `animation-delay:${(0.25 + (k++) * 0.07).toFixed(2)}s` : '';
    return (
      <a class="rg" href={u(href)} data-name={r.name} data-x={r.cx} data-y={r.cy} data-seen={seen ? '1' : '0'} aria-label={`${r.name}, ${seen ? 'visited' : 'on my list'}`}>
        <path class={seen ? 'vis' : 'nv'} style={delay} d={r.d} />
      </a>
    );
  })}
  <g aria-hidden="true" style="pointer-events:none">
    <circle cx="198" cy="234" r="5" fill="#1F1A1B" />
    <circle cx="198" cy="234" r="10" fill="none" stroke="#1F1A1B" stroke-width="1.2" />
    {label && <text class="rg-label" x="0" y="0" text-anchor="middle"></text>}
  </g>
</svg>
<style is:global>
  .italy{display:block;overflow:visible}
  @keyframes paintin{from{opacity:0}to{opacity:1}}
  .italy .rg path{stroke-linejoin:round;transition:fill .2s ease,stroke-width .2s ease}
  .italy .rg path.vis{fill:var(--indigo-wash);stroke:var(--paper);stroke-width:1;animation:paintin .9s ease both}
  .italy .rg path.nv{fill:var(--paper);stroke:var(--ink);stroke-opacity:.6;stroke-width:.8;stroke-dasharray:2.5 2.5}
  .italy .rg:hover path.vis,.italy .rg:focus-visible path.vis{fill:var(--indigo)}
  .italy .rg:hover path.nv,.italy .rg:focus-visible path.nv{stroke-opacity:1;stroke-width:1.4}
  .italy .rg:focus{outline:none}
  .italy .rg-label{font-family:Caveat,cursive;font-size:26px;fill:var(--ink);paint-order:stroke;stroke:var(--paper);stroke-width:5px;opacity:0;transition:opacity .2s ease}
</style>
<script>
  document.querySelectorAll('svg.italy').forEach((svg) => {
    const label = svg.querySelector('.rg-label');
    if (!label) return;
    const show = (e) => {
      const a = e.target.closest && e.target.closest('a.rg');
      if (!a) { label.style.opacity = '0'; return; }
      label.textContent = a.dataset.name + (a.dataset.seen === '1' ? '' : ' · on my list');
      label.setAttribute('x', a.dataset.x);
      label.setAttribute('y', String(+a.dataset.y - 14));
      label.style.opacity = '1';
    };
    svg.addEventListener('pointerover', show);
    svg.addEventListener('focusin', show);
    svg.addEventListener('pointerleave', () => { label.style.opacity = '0'; });
    svg.addEventListener('focusout', () => { label.style.opacity = '0'; });
  });
</script>
