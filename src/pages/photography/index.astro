---
import Base from '../../layouts/Base.astro';
import { u } from '../../data/site.js';
import { FIELD, CATEGORIES } from '../../data/photos.js';
const tiles = FIELD.map(([cat, f, o, word, alt], i) => ({ i, cat, src: u('img/' + f), o, alt, word: word || CATEGORIES[cat].word, link: CATEGORIES[cat].link + ' →', href: u('photography/' + cat + '/') }));
---
<Base title="Photography" active="Photography" overlay={true} footer={false} description="Weddings, family, people, community and travel — photographs by Julia Berchtold, for friends and friends of friends.">
  <main class="field" aria-label="Photography: a field of photos around the word notice">
    <h1 class="sr">Photography</h1>
    {tiles.map((t) => (
      <a class="tile" data-i={t.i} data-o={t.o} href={t.href} aria-label={t.alt}>
        <span class="in"><img src={t.src} alt="" loading={t.i < 10 ? 'eager' : 'lazy'} draggable="false" />
          <span class="oncap"><span class="h">{t.word}</span><span class="l">{t.link}</span></span>
        </span>
      </a>
    ))}
    <div class="word" aria-hidden="true">notice</div>

    <footer class="bar">
      <nav class="caps galleries" aria-label="All galleries">
        <span class="muted">All galleries</span>
        {Object.entries(CATEGORIES).map(([k, c]) => <a href={u('photography/' + k + '/')}>{c.title}</a>)}
      </nav>
      <div class="controls">
        <button type="button" class="sw caps" role="switch" aria-checked="true"><span>Spotlight</span><span class="tr"><span class="kn"></span></span></button>
        <span class="hint">Drag or scroll to look around</span>
        <button type="button" class="toggle" aria-label="Pause motion" title="Pause motion"><span><svg class="i-pause" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><rect x="2.5" y="1.5" width="2.4" height="9" fill="#1F1A1B"/><rect x="7.1" y="1.5" width="2.4" height="9" fill="#1F1A1B"/></svg><svg class="i-play" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.5 L10.5 6 L3 10.5 Z" fill="#1F1A1B"/></svg></span></button>
      </div>
    </footer>
  </main>
</Base>

<style>
  :global(body){overflow:hidden}
  .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
  .field{position:relative;height:100svh;overflow:hidden;touch-action:none;cursor:grab;user-select:none}
  .field.drag{cursor:grabbing}
  .tile{position:absolute;left:0;top:0;display:block;will-change:transform}
  .tile .in{position:relative;display:block;width:100%;height:100%;transition:transform .5s cubic-bezier(.2,.8,.2,1),box-shadow .5s ease}
  .tile img{width:100%;height:100%;object-fit:cover;background:#E6E1D9;pointer-events:none}
  .oncap{position:absolute;right:0;bottom:0;display:flex;flex-direction:column;align-items:flex-end;padding:0 7% 6% 30%;pointer-events:none;color:#FBF8F3;background:radial-gradient(120% 100% at 100% 100%,rgba(20,16,16,.55) 0%,rgba(20,16,16,.22) 45%,rgba(20,16,16,0) 70%);opacity:0;transition:opacity .35s ease}
  .oncap .h{font-family:'Caveat',cursive;font-weight:500;line-height:1;transform:rotate(-3deg);text-shadow:0 1px 8px rgba(0,0,0,.35);white-space:nowrap}
  .oncap .l{letter-spacing:.16em;text-transform:uppercase;border-bottom:1px solid #FBF8F3;white-space:nowrap}
  .tile.f .oncap{opacity:1}
  @keyframes sweep{from{background-position:120% 0}to{background-position:-20% 0}}
  .word{position:absolute;left:0;right:0;top:50%;transform:translateY(-54%);text-align:center;z-index:2;font-family:Fraunces,Georgia,serif;font-weight:200;font-size:clamp(110px,26vw,330px);line-height:1.05;letter-spacing:-0.02em;pointer-events:none;color:transparent;background-image:linear-gradient(100deg,#8F877F 0%,#8F877F 38%,#EFEAE2 50%,#8F877F 62%,#8F877F 100%);background-size:260% 100%;-webkit-background-clip:text;background-clip:text;animation:sweep 9s ease-in-out infinite alternate}
  .bar{position:absolute;left:0;right:0;bottom:0;z-index:20;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:4px 24px;padding:10px 40px 10px var(--gutter);background:linear-gradient(rgba(246,243,238,0),var(--paper) 45%);cursor:auto}
  .galleries{display:flex;flex-wrap:wrap;gap:0 24px;align-items:center}
  .galleries a{text-decoration:none;padding:12px 0}
  .controls{display:flex;align-items:center;gap:8px}
  .hint{font-size:12px;color:var(--muted)}
  .sw{display:flex;align-items:center;gap:10px;min-height:44px;padding:0 6px;border:none;background:transparent;cursor:pointer;font:inherit;font-size:11px;color:var(--ink)}
  .sw .tr{width:34px;height:20px;border-radius:999px;position:relative;background:var(--ink);transition:background .25s ease}
  .sw .kn{position:absolute;top:2px;left:16px;width:16px;height:16px;border-radius:50%;background:var(--paper);transition:left .25s ease;box-shadow:0 1px 3px rgba(0,0,0,.25)}
  .sw[aria-checked="false"] .tr{background:#C9C2BA} .sw[aria-checked="false"] .kn{left:2px}
  .toggle{width:44px;height:44px;border-radius:50%;border:none;background:transparent;display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0}
  .toggle > span{width:32px;height:32px;border-radius:50%;border:1px solid #1F1A1B55;display:flex;align-items:center;justify-content:center;background:var(--paper)}
  .toggle .i-play{display:none} .toggle.paused .i-play{display:block} .toggle.paused .i-pause{display:none}
  @media (max-width:820px){ .hint{display:none} .bar{padding:6px var(--gutter) 10px} .galleries{gap:0 16px;font-size:10px} }
</style>

<script>
  const field = document.querySelector('.field');
  const tiles = [...field.querySelectorAll('.tile')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let K = 1, W = 1900, H = 1220, CX = 640, CY = 410;
  let t = 0, ox = 0, oy = 0, px = 0, py = 0, tpx = 0, tpy = 0, paused = false, spot = true;
  let hover = null, kbd = null, drag = null, moved = 0, lastF = null, flip = false, idleUntil = 0;
  const SP = 1.4;

  // seeded Poisson-ish scatter on a wrapping plane
  let seed = 1234567 + tiles.length * 97;
  const rnd = () => { seed |= 0; seed = seed + 0x6D2B79F5 | 0; let x = Math.imul(seed ^ seed >>> 15, 1 | seed); x = x + Math.imul(x ^ x >>> 7, 61 | x) ^ x; return ((x ^ x >>> 14) >>> 0) / 4294967296; };
  const BW = 1900, BH = 1220, n = tiles.length, minD = Math.sqrt(BW * BH / n) * 0.82, pts = [];
  for (let tries = 0; pts.length < n && tries < 20000; tries++) {
    const x = rnd() * BW, y = rnd() * BH;
    if (pts.every((p) => { let dx = Math.abs(p.x - x), dy = Math.abs(p.y - y); dx = Math.min(dx, BW - dx); dy = Math.min(dy, BH - dy); return Math.hypot(dx, dy) > minD * (tries > 8000 ? .75 : 1); })) pts.push({ x, y });
  }
  const items = tiles.map((el, i) => {
    const back = i % 5 === 1 || i % 5 === 3;
    return { el, inn: el.querySelector('.in'), h: el.querySelector('.h'), l: el.querySelector('.l'), i, back, depth: back ? .62 : 1, k: back ? .74 : 1, p: el.dataset.o === 'p', bx: pts[i % pts.length].x, by: pts[i % pts.length].y };
  });

  const resize = () => {
    const r = field.getBoundingClientRect();
    K = Math.max(.55, Math.min(1, r.width / 1280));
    W = BW * K; H = BH * K; CX = r.width / 2; CY = r.height / 2;
    items.forEach((it) => {
      it.w = (it.p ? 190 : 284) * it.k * K; it.hh = (it.p ? 284 : 190) * it.k * K;
      it.el.style.width = it.w.toFixed(0) + 'px'; it.el.style.height = it.hh.toFixed(0) + 'px';
      it.el.style.zIndex = '1';
      it.inn.style.boxShadow = it.back ? '0 4px 12px rgba(31,26,27,.08)' : '0 10px 24px rgba(31,26,27,.12)';
    });
  };
  resize(); addEventListener('resize', resize);
  const wrap = (v, m) => { v = ((v % m) + m) % m; return v > m / 2 ? v - m : v; };

  let prev = performance.now();
  const loop = (now) => {
    const dt = Math.min(50, now - prev); prev = now;
    if (!paused && !reduce && hover === null && kbd === null && !drag && now > idleUntil) t += dt / 1000;
    px += (tpx - px) * .06; py += (tpy - py) * .06;
    const w = 2 * Math.PI / 120;
    const camX = (520 * Math.cos(t * w)) * K + ox + px * 70 * K, camY = (290 * Math.sin(t * w)) * K + oy + py * 45 * K;
    let best = null, bestD = 1e9;
    const pos = items.map((it) => {
      const dx = wrap(it.bx * K - camX * it.depth, W), dy = wrap(it.by * K - camY * it.depth, H), d = Math.hypot(dx, dy);
      if (d < bestD) { bestD = d; best = it.i; }
      return { dx, dy, d };
    });
    const focus = kbd !== null ? kbd : hover !== null ? hover : (spot && bestD < 230 * K ? best : null);
    if (focus !== lastF) { lastF = focus; flip = !flip; }
    items.forEach((it) => {
      const p = pos[it.i], near = Math.max(0, 1 - p.d / (300 * K)), isF = it.i === focus;
      const s = isF ? (it.back ? SP / .74 : SP) : 1 + .16 * near;
      const sx = CX + p.dx - it.w / 2, sy = CY + p.dy - it.hh / 2;
      const cxs = CX + p.dx, cys = CY + p.dy, fw = CX * 2, fh = CY * 2;
      const oxs = cxs < fw * .26 ? '0%' : cxs > fw * .74 ? '100%' : '50%', oys = cys < fh * .34 ? '0%' : cys > fh * .7 ? '100%' : '50%';
      it.el.style.transform = `translate(${sx.toFixed(1)}px,${sy.toFixed(1)}px)`;
      it.el.style.zIndex = isF ? '12' : '1';
      it.inn.style.transformOrigin = oxs + ' ' + oys;
      it.inn.style.transform = `scale(${s.toFixed(3)})`;
      if (isF !== it.wasF) {
        it.wasF = isF; it.el.classList.toggle('f', isF);
        it.h.style.fontSize = (40 * K / s).toFixed(1) + 'px';
        it.l.style.fontSize = (10.5 * Math.max(K, .8) / s).toFixed(2) + 'px'; it.l.style.marginTop = (6 / s).toFixed(1) + 'px';
        it.h.style.animation = isF && !reduce ? (flip ? 'writeA' : 'writeB') + ' .9s cubic-bezier(.6,.1,.3,1) .2s both' : 'none';
      }
    });
    requestAnimationFrame(loop);
  };
  requestAnimationFrame(loop);

  field.addEventListener('pointermove', (e) => {
    const r = field.getBoundingClientRect();
    const tile = e.pointerType === 'mouse' && e.target.closest ? e.target.closest('.tile') : null;
    hover = tile ? +tile.dataset.i : null;
    if (drag) { const dx = e.clientX - drag[0], dy = e.clientY - drag[1]; moved += Math.abs(dx) + Math.abs(dy); ox -= dx; oy -= dy; drag = [e.clientX, e.clientY]; }
    else if (e.pointerType === 'mouse') { tpx = ((e.clientX - r.left) / r.width - .5) * 2; tpy = ((e.clientY - r.top) / r.height - .5) * 2; }
  });
  field.addEventListener('pointerdown', (e) => { if (e.target.closest('header,.bar')) return; drag = [e.clientX, e.clientY]; moved = 0; field.classList.add('drag'); });
  const end = () => { drag = null; field.classList.remove('drag'); };
  field.addEventListener('pointerup', end); field.addEventListener('pointercancel', end);
  field.addEventListener('pointerleave', () => { hover = null; tpx = tpy = 0; end(); });
  field.addEventListener('click', (e) => { if (moved > 8 && e.target.closest('.tile')) { e.preventDefault(); } }, true);
  tiles.forEach((el) => { el.addEventListener('focus', () => kbd = +el.dataset.i); el.addEventListener('blur', () => { if (kbd === +el.dataset.i) kbd = null; }); });

  // Trackpad two-finger scroll and mouse wheel pan the field; arrow keys too.
  field.addEventListener('wheel', (e) => {
    if (e.target.closest('header,.bar')) return;
    e.preventDefault();
    if (e.ctrlKey) return; // pinch: ignore rather than zoom the page
    const k = e.deltaMode === 1 ? 16 : 1;
    ox += e.deltaX * k; oy += e.deltaY * k; hover = null;
    idleUntil = performance.now() + 1500;
  }, { passive: false });
  addEventListener('keydown', (e) => {
    if (/INPUT|TEXTAREA/.test(document.activeElement?.tagName || '')) return;
    const step = 80, m = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step] }[e.key];
    if (!m) return; e.preventDefault(); ox += m[0]; oy += m[1]; idleUntil = performance.now() + 1500;
  });

  const sw = field.querySelector('.sw');
  sw.addEventListener('click', () => { spot = !spot; sw.setAttribute('aria-checked', String(spot)); });
  const tg = field.querySelector('.toggle');
  tg.addEventListener('click', () => { paused = !paused; tg.classList.toggle('paused', paused); const l = paused ? 'Play motion' : 'Pause motion'; tg.setAttribute('aria-label', l); tg.title = l; });
</script>
