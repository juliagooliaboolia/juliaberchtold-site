---
import Base from '../../layouts/Base.astro';
import { u, ARCHIVE_URL, INSTAGRAM } from '../../data/site.js';
---
<Base title="About" active="About" image="img/julia-camera.jpg" description="I'm Julia (or Juju): an amateur photographer, designer, maker, and collector of moments, stories, and way too many hobbies.">
  <main class="wrap">
    <section class="hero">
      <img class="main" src={u('img/julia-camera.jpg')} alt="Julia laughing behind her camera, with Rome behind her" />
      <div class="txt">
        <span class="caps muted">About</span>
        <h1 class="display" style="font-size:clamp(44px,5vw,56px)">Hi, I'm Julia.</h1>
        <p class="lead">I'm Julia (or "Juju"), an amateur photographer, designer, maker, and collector of moments, stories, and way too many hobbies. I'm endlessly fascinated by people, the places that shape us, and the beauty hiding in plain sight. This little space is where all my curiosities come together.</p>
        <p class="lead">Behind the camera, my real skill is people. I'm good at putting strangers at ease and bringing energy into a room, and some of it ends up in the photos. I photograph friends, and friends of friends. If that might be you, say hello.</p>
        <span class="hand" style="font-size:58px;transform:rotate(-4deg);align-self:flex-start">Julia</span>
        <div style="display:flex;gap:12px;flex-wrap:wrap"><a class="pill solid caps" href={u('inquire/')}>Inquire</a><a class="pill caps" href={INSTAGRAM.url}>Instagram</a></div>
      </div>
    </section>

    <section class="facts">
      <div class="list">
        <span class="caps muted" style="margin-bottom:12px">A few things about me</span>
        <div class="fact"><span class="caps muted">Home</span><span>Greenpoint, Brooklyn, by way of inland California</span></div>
        <div class="fact"><span class="caps muted">Italy so far</span><span>18 of 20 regions · Friuli-Venezia Giulia and Basilicata next</span></div>
        <div class="fact"><span class="caps muted">Off camera</span><span>Watercolor, jewelry, piano, and too many other hobbies</span></div>
        <div class="fact"><span class="caps muted">Day job</span><span>Experience designer</span></div>
      </div>
      <div class="pics">
        <img src={u('img/julia-steps.jpg')} alt="Julia taking a photo from the top of the Spanish Steps" loading="lazy" />
        <img src={u('img/julia-vittoriano.jpg')} alt="Julia in front of the Vittoriano in Rome" loading="lazy" style="margin-top:56px" />
      </div>
    </section>

    <section class="start">
      <span class="caps muted">Where this started</span>
      <p class="lead">Before this site there was Il Bel Viaggio, a little photo blog I kept from 2015 to 2016. It's still there, just as it was.</p>
      <a class="lnk" href={ARCHIVE_URL}>Visit the archive: Il Bel Viaggio →</a>
    </section>
  </main>
</Base>
<style>
  .hero{display:grid;grid-template-columns:5fr 1fr 6fr;align-items:center;padding:24px 0 0}
  .main{grid-column:1;width:100%;aspect-ratio:4/5;object-fit:cover}
  .txt{grid-column:3;display:flex;flex-direction:column;gap:20px}
  .facts{display:grid;grid-template-columns:5fr 1fr 6fr;align-items:start;padding:112px 0 0}
  .list{display:flex;flex-direction:column}
  .fact{display:grid;grid-template-columns:140px minmax(0,1fr);gap:16px;padding:16px 0;border-top:1px solid var(--line);font-size:15px}
  .pics{grid-column:3;display:grid;grid-template-columns:1fr 1fr;gap:20px}
  .pics img{width:100%;aspect-ratio:2/3;object-fit:cover}
  .start{display:flex;flex-direction:column;gap:14px;max-width:720px;padding:112px 0 72px}
  @media (max-width:820px){
    .hero,.facts{grid-template-columns:1fr;gap:28px} .txt,.pics{grid-column:1} .facts{padding-top:64px} .start{padding-top:64px}
    .fact{grid-template-columns:110px 1fr}
  }
</style>
