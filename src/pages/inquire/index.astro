---
import Base from '../../layouts/Base.astro';
import Inquiry from '../../components/Inquiry.astro';
import { INSTAGRAM, INSTAGRAM_STUDIO } from '../../data/site.js';
import { COPY } from '../../data/copy.js';
const Q = COPY.inquire;
---
<Base title="Inquire" active="Inquire" description={Q.description}>
  <main class="wrap">
    <section class="top">
      <h1 class="display">{Q.heading}</h1>
      <div class="sub">
        <p class="lead">{Q.intro}</p>
        <p class="muted" style="margin:0">{Q.instagram_line} <a href={INSTAGRAM.url}>{INSTAGRAM.handle}</a> · <a href={INSTAGRAM_STUDIO.url}>{INSTAGRAM_STUDIO.handle}</a></p>
      </div>
    </section>
    <div class="pair">
      <Inquiry kind="shoot" id="shoot" card />
      <Inquiry kind="jewelry" id="jewelry" card />
    </div>
  </main>
</Base>
<style>
  .top{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:48px;align-items:end;padding:8px 0 32px}
  .top .display{font-size:clamp(48px,6vw,76px);margin:0}
  .sub{display:flex;flex-direction:column;gap:10px}
  .sub .lead{margin:0;font-size:17px}
  .pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;padding-bottom:72px;align-items:stretch}
  @media (max-width:820px){ .top{grid-template-columns:1fr;gap:16px} .pair{grid-template-columns:1fr} }
</style>
