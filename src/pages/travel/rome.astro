---
import Base from '../../layouts/Base.astro';
import { u } from '../../data/site.js';
import { COPY } from '../../data/copy.js';
import { Content, getHeadings } from '../../content/rome.md';
const heads = getHeadings().filter((h) => h.depth <= 3 && !/^(If you've been before|Book these now)/.test(h.text));
---
<Base title="Rome, a personal guide" active="Travel" image="img/julia-steps.jpg" description={COPY.rome_guide.description}>
  <main class="wrap">
    <header class="top">
      <nav class="caps crumbs" aria-label="Breadcrumb"><a href={u('travel/')}>Travel</a><span aria-hidden="true">/</span><span>Rome</span></nav>
      <span class="fr ve" style="font-size:clamp(64px,8vw,104px)">Rome</span>
      <p class="caps muted">{COPY.rome_guide.dateline}</p>
    </header>
    <div class="layout">
      <aside class="toc" aria-label="In this guide">
        <span class="caps muted">In this guide</span>
        <ol>
          {heads.map((h) => <li class={'d' + h.depth}><a href={'#' + h.slug}>{h.text}</a></li>)}
        </ol>
      </aside>
      <article class="guide"><Content /></article>
    </div>
  </main>
</Base>
<style>
  .top{display:flex;flex-direction:column;gap:14px;padding:24px 0 48px;border-bottom:1px solid var(--line)}
  .crumbs{display:flex;gap:10px;color:var(--muted)} .crumbs a{color:var(--muted);text-decoration:none}
  .top p{margin:0}
  .layout{display:grid;grid-template-columns:240px minmax(0,1fr);gap:64px;padding:48px 0 72px}
  .toc{position:sticky;top:24px;align-self:start;max-height:calc(100vh - 48px);overflow:auto;display:flex;flex-direction:column;gap:12px}
  .toc ol{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px;font-size:14px}
  .toc a{text-decoration:none} .toc .d3{padding-left:14px;font-size:13px;color:var(--muted)} .toc .d3 a{color:var(--muted)}
  .guide{max-width:720px;font-size:17px;line-height:1.7;color:var(--body)}
  .guide :global(h2){font-family:Fraunces,Georgia,serif;font-weight:300;font-size:40px;line-height:1.1;color:var(--ink);margin:72px 0 16px;font-variation-settings:'opsz' 144,'wght' 300,'SOFT' 30;scroll-margin-top:24px}
  .guide :global(h2:first-child){margin-top:0}
  .guide :global(h3){font-family:Fraunces,Georgia,serif;font-style:italic;font-weight:400;font-size:30px;color:var(--ink);margin:56px 0 6px;font-variation-settings:'opsz' 72,'wght' 380,'SOFT' 50,'WONK' 1;scroll-margin-top:24px}
  .guide :global(h3 + p em:only-child){color:var(--muted)}
  .guide :global(h4){font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);font-weight:500;margin:32px 0 8px;padding-top:16px;border-top:1px solid var(--line)}
  .guide :global(p){margin:0 0 16px}
  .guide :global(strong){color:var(--ink);font-weight:600}
  .guide :global(a){text-underline-offset:3px}
  .guide :global(table){width:100%;border-collapse:collapse;margin:8px 0 24px;font-size:15px}
  .guide :global(th){text-align:left;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);font-weight:500;padding:8px 12px 8px 0;border-bottom:1px solid var(--ink)}
  .guide :global(td){padding:12px 12px 12px 0;border-bottom:1px solid var(--line);vertical-align:top}
  .guide :global(td:first-child){width:32%;color:var(--muted)}
  .guide :global(ul),.guide :global(ol){padding-left:22px;margin:0 0 16px}
  .guide :global(li){margin-bottom:6px}
  @media (max-width:900px){ .layout{grid-template-columns:1fr;gap:24px} .toc{position:static;max-height:none} .toc ol{display:none} .toc{display:none} .guide :global(td:first-child){width:38%} }
</style>
